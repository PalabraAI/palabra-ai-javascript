{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "target": "ES2020",
        "paths": {
            "~/*": [
                "src/*"
            ]
        }
    },
    "exclude": [
        "vite.config.ts",
        "vite.config.d.ts",
        "node_modules",
        "dist",
    ]
}